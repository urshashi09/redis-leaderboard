{
  "swagger": "2.0",
  "info": {
    "title": "High-Performance Redis Leaderboard API",
    "description": "A real-time gaming leaderboard API built with Node.js, Express, and Redis. Uses Redis Sorted Sets for fast ranking operations and Redis Hashes for player metadata. Write-heavy endpoints are rate-limited to 30 requests per IP per minute.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [
    {
      "name": "Health",
      "description": "API and Redis health status"
    },
    {
      "name": "Leaderboard",
      "description": "Read leaderboard rankings"
    },
    {
      "name": "Management",
      "description": "Create, update, and delete players and scores"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns the operational status of the API and the Redis connection.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API and Redis are healthy",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            },
            "examples": {
              "application/json": {
                "status": "ok",
                "redis": "connected"
              }
            }
          },
          "503": {
            "description": "Redis is unavailable",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            },
            "examples": {
              "application/json": {
                "status": "degraded",
                "redis": "disconnected"
              }
            }
          }
        }
      }
    },
    "/api/leaderboard": {
      "get": {
        "tags": ["Leaderboard"],
        "summary": "Get top players or a rank range",
        "description": "Returns ranked players in descending score order. Supply only `limit` for top-N, or both `from` and `to` for a rank range.",
        "operationId": "getLeaderboard",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of top players to return (default 10). Ignored when from/to are set.",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 1000
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start rank (1-based, inclusive). Use together with `to`.",
            "required": false,
            "type": "integer",
            "minimum": 1
          },
          {
            "name": "to",
            "in": "query",
            "description": "End rank (1-based, inclusive). Use together with `from`.",
            "required": false,
            "type": "integer",
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "List of ranked players",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RankedPlayer"
              }
            },
            "examples": {
              "application/json": [
                {
                  "rank": 1,
                  "username": "DragonSlayer99",
                  "score": 98500,
                  "country": "US",
                  "tier": "Diamond"
                },
                {
                  "rank": 2,
                  "username": "NightOwl42",
                  "score": 87200,
                  "country": "UK",
                  "tier": "Platinum"
                }
              ]
            }
          },
          "400": {
            "description": "Invalid or missing request parameters",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/api/leaderboard/score-range": {
      "get": {
        "tags": ["Leaderboard"],
        "summary": "Get players within a score range",
        "description": "Returns all players whose score falls between `min` and `max` (inclusive), ranked highest first.",
        "operationId": "getLeaderboardByScoreRange",
        "parameters": [
          {
            "name": "min",
            "in": "query",
            "description": "Minimum score (inclusive)",
            "required": true,
            "type": "number"
          },
          {
            "name": "max",
            "in": "query",
            "description": "Maximum score (inclusive)",
            "required": true,
            "type": "number"
          }
        ],
        "responses": {
          "200": {
            "description": "Players within the specified score range",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RankedPlayer"
              }
            }
          },
          "400": {
            "description": "Invalid or missing query parameters",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/api/leaderboard/player/{username}": {
      "get": {
        "tags": ["Leaderboard"],
        "summary": "Get a single player's rank, score, and metadata",
        "operationId": "getPlayer",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "The player's unique username",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Player details",
            "schema": {
              "$ref": "#/definitions/RankedPlayer"
            },
            "examples": {
              "application/json": {
                "rank": 1,
                "username": "DragonSlayer99",
                "score": 98500,
                "country": "US",
                "tier": "Diamond",
                "avatar": "https://example.com/avatar.png",
                "joined": "2024-01-15T10:30:00Z"
              }
            }
          },
          "404": {
            "description": "Player not found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      },
      "delete": {
        "tags": ["Management"],
        "summary": "Remove a player",
        "description": "Deletes the player from the leaderboard and removes their metadata hash.",
        "operationId": "deletePlayer",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "The player's unique username",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Player removed successfully",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            },
            "examples": {
              "application/json": {
                "message": "Player DragonSlayer99 removed successfully"
              }
            }
          },
          "404": {
            "description": "Player not found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/api/leaderboard/player": {
      "post": {
        "tags": ["Management"],
        "summary": "Register a new player",
        "description": "Creates a player entry with an initial score and optional metadata. Rate-limited: 30 requests per IP per minute.",
        "operationId": "createPlayer",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreatePlayerRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Player created successfully",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            },
            "examples": {
              "application/json": {
                "message": "Player NewPlayer created successfully",
                "username": "NewPlayer",
                "score": 0
              }
            }
          },
          "400": {
            "description": "Invalid or missing request body",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "409": {
            "description": "Username already exists",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error": "Username NewPlayer already exists"
              }
            }
          },
          "429": {
            "description": "Too many requests – rate limit exceeded (30 req/IP/min)",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "error": "Too many requests, please try again later"
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/api/leaderboard/score": {
      "post": {
        "tags": ["Management"],
        "summary": "Set a player's absolute score",
        "description": "Replaces the player's current score with the given value. Rate-limited: 30 requests per IP per minute.",
        "operationId": "setScore",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SetScoreRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Score updated",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            },
            "examples": {
              "application/json": {
                "message": "Score updated for Player1",
                "username": "Player1",
                "score": 5000
              }
            }
          },
          "400": {
            "description": "Invalid or missing request body",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Player not found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "429": {
            "description": "Too many requests – rate limit exceeded (30 req/IP/min)",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/api/leaderboard/increment": {
      "post": {
        "tags": ["Management"],
        "summary": "Increment a player's score",
        "description": "Atomically increments the player's current score by the given amount. Rate-limited: 30 requests per IP per minute.",
        "operationId": "incrementScore",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/IncrementScoreRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Score incremented",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            },
            "examples": {
              "application/json": {
                "message": "Score incremented for Player1",
                "username": "Player1",
                "newScore": 5150
              }
            }
          },
          "400": {
            "description": "Invalid or missing request body",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Player not found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "429": {
            "description": "Too many requests – rate limit exceeded (30 req/IP/min)",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/api/leaderboard/reset": {
      "post": {
        "tags": ["Management"],
        "summary": "Reset the leaderboard",
        "description": "Clears all players and scores from the leaderboard sorted set. This action is irreversible.",
        "operationId": "resetLeaderboard",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Leaderboard cleared",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            },
            "examples": {
              "application/json": {
                "message": "Leaderboard reset successfully"
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "RankedPlayer": {
      "type": "object",
      "properties": {
        "rank": {
          "type": "integer",
          "example": 1,
          "description": "1-based rank (highest score = rank 1)"
        },
        "username": {
          "type": "string",
          "example": "DragonSlayer99",
          "description": "Unique player identifier"
        },
        "score": {
          "type": "number",
          "example": 98500,
          "description": "Current leaderboard score"
        },
        "country": {
          "type": "string",
          "example": "US",
          "description": "Two-letter country code"
        },
        "tier": {
          "type": "string",
          "example": "Diamond",
          "description": "Player tier / division"
        },
        "avatar": {
          "type": "string",
          "example": "https://example.com/avatar.png",
          "description": "URL of the player's avatar image"
        },
        "joined": {
          "type": "string",
          "format": "date-time",
          "example": "2024-01-15T10:30:00Z",
          "description": "ISO 8601 timestamp of when the player was registered"
        }
      }
    },
    "CreatePlayerRequest": {
      "type": "object",
      "required": ["username"],
      "properties": {
        "username": {
          "type": "string",
          "example": "NewPlayer"
        },
        "score": {
          "type": "number",
          "example": 0,
          "default": 0
        },
        "country": {
          "type": "string",
          "example": "US"
        },
        "tier": {
          "type": "string",
          "example": "Gold"
        },
        "avatar": {
          "type": "string",
          "example": "https://example.com/avatar.png"
        }
      }
    },
    "SetScoreRequest": {
      "type": "object",
      "required": ["username", "score"],
      "properties": {
        "username": {
          "type": "string",
          "example": "Player1"
        },
        "score": {
          "type": "number",
          "example": 5000,
          "description": "Absolute score value to assign"
        }
      }
    },
    "IncrementScoreRequest": {
      "type": "object",
      "required": ["username", "amount"],
      "properties": {
        "username": {
          "type": "string",
          "example": "Player1"
        },
        "amount": {
          "type": "number",
          "example": 150,
          "description": "Value to add to the current score (can be negative)"
        }
      }
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Operation completed successfully"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "An error occurred"
        }
      }
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "degraded"],
          "example": "ok"
        },
        "redis": {
          "type": "string",
          "enum": ["connected", "disconnected"],
          "example": "connected"
        }
      }
    }
  }
}